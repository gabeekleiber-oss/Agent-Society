# Copy these examples into your shell environment as needed.
# The application does not automatically load this file.

# Choose the provider you want to use and set its API key.
# NVIDIA NIM:
# NVIDIA_API_KEY=replace-with-your-key

# Other hosted providers:
# GROQ_API_KEY=replace-with-your-key
# OPENROUTER_API_KEY=replace-with-your-key
# MISTRAL_API_KEY=replace-with-your-key
# CEREBRAS_API_KEY=replace-with-your-key
# OPENAI_API_KEY=replace-with-your-key
# GEMINI_API_KEY=replace-with-your-key
# GOOGLE_API_KEY=replace-with-your-key

# Optional tuning:
# AGENT_MODEL=provider-model-id
# AGENT_RPM=20
# AGENT_TPM=0
# AGENT_MAX_TOKENS=2000
# AGENT_TEMPERATURE=0.7
# AGENT_TIMEOUT=150

# Local Ollama endpoint, if using --brain ollama:
# OLLAMA_HOST=http://localhost:11434
